# Souul — Environment Variables Template
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git

# Supabase (get from your Supabase project dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email via Resend (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=hello@heylulu.app

# Analytics — Plausible (privacy-first, no cookies)
# Only added to public pages — NEVER on /play routes
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=heylulu.app
